# marcobarrios.fi Geoipupdate container image
# marcobarrios.fi-geoipupdate

# Latest Alpine release
FROM alpine:latest

# Container image version
LABEL version='1.0.0'
# Application name
LABEL image.app-name='GeoIP Update'
# Container image description
LABEL description='Application for updating MaxMind GeoIP and GeoLite2 databases'
# Operating system version
LABEL image.os-version='3.21.3'
# Application version
LABEL image.app-version='8.0.0'
# Application website
LABEL image.app-url='https://dev.maxmind.com/geoip/'
# Application documentation
LABEL image.app-docs='https://dev.maxmind.com/geoip/updating-databases/'
# Application repository
LABEL image.app-repo='https://github.com/maxmind/geoipupdate/'

# See also DB-IP free IP geolocation databases
# https://db-ip.com/db/lite.php

### Variables

# App build-time variable
ARG APP='geoipupdate'
# App environment variable
ENV APP="$APP"

# Domain build-time variable
ARG DOMAIN='localhost'
# Domain environment variable
ENV DOMAIN="$DOMAIN"

# Group identification build-time variable
ARG GROUP_ID='101'
# Group name build-time variable
ARG GROUP="$APP"

# User identification build-time variable
ARG USER_ID='101'
# User name build-time variable
ARG USER="$APP"

# Data directory build-time variable
ARG DATA_DIR="/var/lib/$APP"
# Data directory environment variable
ENV DATA_DIR="$DATA_DIR"

# Database directory build-time variable
ARG DATABASE_DIR='/usr/local/share/GeoIP'
# Database directory environment variable
ENV DATABASE_DIR="$DATABASE_DIR"

# Configuration file build-time variable
ARG CONFIG_FILE='/usr/local/etc/GeoIP.conf'
# Configuration file environment variable
ENV GEOIP_CONF="$CONFIG_FILE"

# Log file build-time variable
ARG LOG_FILE="/var/log/$APP.log"
# Log directory environment variable
ENV LOG_FILE="$LOG_FILE"

# Edition identifiers built-time variable
ARG EDITION_IDS='GeoLite2-ASN GeoLite2-City GeoLite2-Country'
# Edition identifiers environment variable
ENV EDITION_IDS="$EDITION_IDS"

# Lowercase filenames option built-time variable
ARG LOWERCASE_FILENAMES='yes'
# Lowercase filenames option environment variable
ENV LOWERCASE_FILENAMES="$LOWERCASE_FILENAMES"

### Users

# Create user group and add user to the group
RUN getent group "$GROUP" || addgroup --gid "$GROUP_ID" "$GROUP" && adduser --uid "$USER_ID" --system --ingroup "$GROUP" "$USER"

### Packages

# Install GNU Gettext environment substitution
RUN apk update && apk add --no-cache gettext-envsubst

### Directories
# Mounted volumes are not available at the build time

# Create GeoIP database directory
RUN mkdir -p "$DATABASE_DIR"

### Applications

### Configuration
# (default configuration file is /usr/local/etc/GeoIP.conf)

### Scripts

# Copy geoipupdate-run shell script
COPY geoipupdate-run.sh '/usr/local/bin/geoipupdate-run'
# Make geoipupdate-run shell script executable
RUN chmod +x '/usr/local/bin/geoipupdate-run'

# Schedule geoipupdate-run shell script to run daily
# (copy geoipupdate-run to the /etc/periodic/daily directory)
RUN cp '/usr/local/bin/geoipupdate-run' '/etc/periodic/daily/'

# Switch to container user
# USER "$GEOIPUPDATE_USER"

# Run geoipupdate-run shell script
ENTRYPOINT geoipupdate-run