# marcobarrios.fi PHP-FPM container image
# marcobarrios.fi-php-fpm

# Latest Alpine release
FROM alpine:latest

# Container image version
LABEL version='1.0.0'
# Application name
LABEL image.app-name='PHP-FPM'
# Container image description
LABEL description='PHP FastCGI process manager for NGINX'
# Operating system version
LABEL image.os-version='3.21.3'
# Application version
LABEL image.app-version='8.4.4'
# Application website
LABEL image.app-url='https://php-fpm.org/'
# Application alternative website
LABEL image.app-alt-url='https://www.php.net/'

### Variables

# App build-time variable
ARG APP='php-fpm'
# App environment variable
ENV APP="$APP"

# Domain build-time variable
ARG DOMAIN='localhost'
# Domain environment variable
ENV DOMAIN="$DOMAIN"

## Group ID and group name

# Group identification build-time variable
ARG GROUP_ID='101'
# Group name build-time variable
ARG GROUP="$APP"
# Group name environment variable
ENV GROUP="$GROUP"

## User ID and user name

# User identification build-time variable
ARG USER_ID='101'
# User name build-time variable
ARG USER="$APP"
# User name environment variable
ENV USER="$USER"

# Data directory build-time variable
ARG DATA_DIR="/var/lib/$APP"
# Data directory environment variable
ENV DATA_DIR="$DATA_DIR"

# Configuration file build-time variable
ARG CONFIG_FILE='/etc/php/php-fpm.d/php-fpm.conf'
# Configuration file environment variable
ENV CONFIG_FILE="$CONFIG_FILE"

# Log file build-time variable
ARG LOG_FILE="/var/log/$APP.log"
# Log file environment variable
ENV LOG_FILE="$LOG_FILE"

# PHP version build-time variable
ARG PHP_VERSION='php84'
# PHP-FPM version build-time variable
ARG PHP_FPM_VERSION='php-fpm84'

# PHP-FPM socket build-time variable 
# (default value is /run/php/php8.4-fpm.sock)
ARG SOCKET='/run/php/php-fpm.sock'
# PHP-FPM socket environment variable
ENV SOCKET="$SOCKET"

### Users

# Create user group and add user to the group
RUN getent group "$GROUP" || addgroup --gid "$GROUP_ID" "$GROUP" && adduser --uid "$USER_ID" --system --ingroup "$GROUP" "$USER"

### Packages

# Install GNU Gettext environment substitution, PHP hypertext preprocessor, and PHP command-line interface (CLI), PHP FastCGI process manager (FPM), and PHP client URL extensions
RUN apk update && apk add --no-cache gettext-envsubst "$PHP_VERSION" "$PHP_VERSION-cli" "$PHP_VERSION-fpm" "$PHP_VERSION-curl"

### Symbolic Links

# Create symbolic link to PHP, PHP-FPM, PHP configuration directory, and PHP log directory
RUN ln -s "/usr/bin/$PHP_VERSION" '/usr/bin/php' && ln -s "/usr/sbin/$PHP_FPM_VERSION" '/usr/sbin/php-fpm' && ln -s "/etc/$PHP_VERSION" '/etc/php' && ln -s "/var/log/$PHP_VERSION" '/var/log/php'

### Directories
# Mounted volumes are not available at the build time

### Configuration

# Set container host name
RUN echo "$APP" > '/etc/hostname' && echo "127.0.1.1 $DOMAIN $APP" >> '/etc/hosts'

# Delete default configuration
RUN rm '/etc/php/php-fpm.d/www.conf'

# Copy configuration template to the temporary directory
COPY 'php-fpm-config-template.conf' '/tmp/php-fpm-config-template.conf'

# Create configuration file from the configuration template and delete the template
RUN envsubst < '/tmp/php-fpm-config-template.conf' > "$CONFIG_FILE" && rm '/tmp/php-fpm-config-template.conf'

# Rename Client URL extension configuration file (does not impact functionality)
RUN mv '/etc/php/conf.d/00_curl.ini' '/etc/php/conf.d/curl.ini'

# Copy initialization script
COPY "$APP-init.sh" "/usr/local/bin/$APP-init"

# Make the initialization script executable
RUN chmod +x "/usr/local/bin/$APP-init"

### Ports

# Expose port 9000 (not applicable when using sockets)
EXPOSE 9000

### User

# Switch to non-root user
# USER "$USER"

ENTRYPOINT ["php-fpm-init"]