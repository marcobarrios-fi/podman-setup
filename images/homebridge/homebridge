# marcobarrios.fi Homebridge container image
# homebridge

# Latest Alpine release
FROM alpine:latest

### Metadata

# Container image version
LABEL version='1.0.0'
# Application name
LABEL image.app-name='Homebridge'
# Container image description
LABEL description='Apple Home translation layer for unsupported devices'
# Operating system version
LABEL image.os-version='3.21.3'
# Application version
LABEL image.app-version='1.11.0'
# Application website
LABEL image.app-url='http://homebridge.io/'

### Variables

# App build-time variable
ARG APP='homebridge'
# App environment variable
ENV APP="$APP"

# Domain build-time variable
ARG DOMAIN='localhost'
# Domain environment variable
ENV DOMAIN="$DOMAIN"

# Group identification build-time variable
ARG GROUP_ID='101'
# Group name build-time variable
ARG GROUP="$APP"

# User identification build-time variable
ARG USER_ID='101'
# User name build-time variable
ARG USER="$APP"

# Data directory build-time variable
ARG DATA_DIR="/var/lib/$APP"
# Data directory environment variable
ENV DATA_DIR="$DATA_DIR"

# Log file build-time variable
ARG LOG_FILE="/var/log/$APP.log"
# Log file environment variable
ENV LOG_FILE="$LOG_FILE"

## Application Configuration

# Port build-time variable
ARG PORT='51826'
# Port environment variable
ENV PORT="$PORT"

# Username build-time variable
ARG USERNAME='CC:22:3D:E3:CE:30'
# Username environment variable
ENV USERNAME="$USERNAME"

## Frontend Configuration

# Frontend port build-time variable
ARG FRONTEND_PORT='8581'
# Frontend port environment variable
ENV FRONTEND_PORT="$FRONTEND_PORT"

## MQTT Configuration

# MQTT server build-time variable
ARG MQTT_SERVER='localhost'
# MQTT server environment variable
ENV MQTT_SERVER="$MQTT_SERVER"

# MQTT port build-time variable
ARG MQTT_PORT='1883'
# MQTT port environment variable
ENV MQTT_PORT="$MQTT_PORT"

# MQTT base topic build-time variable
ARG MQTT_BASE_TOPIC='zigbee2mqtt'
# MQTT base topic environment variable
ENV MQTT_BASE_TOPIC="$MQTT_BASE_TOPIC"

# MQTT username build-time variable
# (authentication is disabled by default)
ARG MQTT_USERNAME='mqtt'
# MQTT username environment variable
ENV MQTT_USERNAME="$MQTT_USERNAME"

## SSL Configuration

# SSL private key build-time variable
# (SSL private key must be provided in the configuration file)
ARG SSL_KEY=
# SSL private key environment variable
ENV SSL_KEY="$SSL_KEY"

# SSL certificate build-time variable
# (SSL certificate must be provided in the configuration file)
ARG SSL_CERT=
# SSL certificate environment variable
ENV SSL_CERT="$SSL_CERT"

### Users

# Create user group and add user to the group
RUN getent group "$GROUP" || addgroup --gid "$GROUP_ID" "$GROUP" && adduser --uid "$USER_ID" --system --ingroup "$GROUP" "$USER"

### Packages

# Install GNU Gettext environment substitution, Node.js JavaScript runtime environment, and Node package manager (NPM)
RUN apk update && apk add --no-cache gettext-envsubst nodejs npm

# Install Homebridge
RUN npm install --global --omit=dev --no-fund --no-audit homebridge

# Install Homebridge UI
RUN npm install --global --omit=dev --no-fund --no-audit homebridge-config-ui-x

# Install Zigbee2MQTT plugin
# RUN npm install --global --omit=dev homebridge-z2m

# Install latest beta version of Zigbee2MQTT plugin
RUN npm install --global --omit=dev homebridge-z2m@next

### Directories
# Mounted volumes are not available at the build time

### Configuration

# Set container host name
RUN echo "$APP" > '/etc/hostname' && echo "127.0.1.1 $DOMAIN $APP" >> '/etc/hosts'

# Set Homebridge UI binary
ENV UI_BIN='/usr/local/lib/node_modules/homebridge-config-ui-x/dist/bin/standalone.js'

# Copy configuration template to the temporary directory
COPY 'homebridge-config-template.json' '/tmp/config-template.json'

### Secrets
# Secrets are not available at the build time

### Scripts

# Copy initialization script
COPY "$APP-init.sh" "/usr/local/bin/$APP-init"

# Make the initialization script executable
RUN chmod +x "/usr/local/bin/$APP-init"

### Ports

# EXPOSE "$PORT"
# EXPOSE "$FRONTEND_PORT"

### User

# Switch to container user
# USER "$USER"

ENTRYPOINT ["homebridge-init"]