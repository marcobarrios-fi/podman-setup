{
  "name": "matterbridge-zigbee2mqtt",
  "type": "DynamicPlatform",
  "version": "3.1.0",
  "host": "mqtt://${MQTT_SERVER}",
  "port": ${MQTT_PORT},
  "protocolVersion": 5,
  "username": "${MQTT_USER}",
  "password": "${MQTT_PASSWORD}",
  "rejectUnauthorized": true,
  "topic": "${MQTT_BASE_TOPIC}",  
