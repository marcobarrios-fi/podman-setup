# marcobarrios.fi Mosquitto container image
# marcobarrios.fi-mosquitto

# Latest Alpine release
FROM alpine:latest

### Metadata

# Container image version
LABEL version='1.0.0'
# Application name
LABEL image.app-name='Mosquitto'
# Container image description
LABEL description='MQTT (Message Queuing Telemetry Transport) broker'
# Operating system version
LABEL image.os-version='3.21.3'
# Application version
LABEL image.app-version='2.0.20'
# Application website
LABEL image.app-url='https://mosquitto.org/'

### Variables

# App build-time variable
ARG APP='mosquitto'
# App environment variable
ENV APP="$APP"

# Domain build-time variable
ARG DOMAIN='localhost'
# Domain environment variable
ENV DOMAIN="$DOMAIN"

# Group identification build-time variable
ARG GROUP_ID='101'
# Group identification environment variable
ENV GROUP_ID="$GROUP_ID"
# Group name build-time variable
ARG GROUP="$APP"
# Group name environment variable
ENV GROUP="$GROUP"

# User identification build-time variable
ARG USER_ID='101'
# User identification environment variable
ENV USER_ID="$USER_ID"
# User name build-time variable
ARG USER="$APP"
# User name environment variable
ENV USER="$USER"

# Data directory build-time variable
ARG DATA_DIR="/var/lib/$APP"
# Data directory environment variable
ENV DATA_DIR="$DATA_DIR"

# Configuration file build-time variable
ARG CONFIG_FILE='/etc/mosquitto/mosquitto.conf'
# Configuration file environment variable
ENV CONFIG_FILE="$CONFIG_FILE"

# Log file build-time variable
ARG LOG_FILE="/var/log/$APP.log"
# Log file environment variable
ENV LOG_FILE="$LOG_FILE"

## Password Configuration

# Password file build-time variable
ARG PASSWORD_FILE='/etc/mosquitto/passwd'
# Password file environment variable
ENV PASSWORD_FILE="$PASSWORD_FILE"

## MQTT Configuration

# MQTT port build-time variable
ARG MQTT_PORT='1883'
# MQTT port environment variable
ENV MQTT_PORT="$MQTT_PORT"

# MQTT username build-time variable
# (authentication is disabled by default)
ARG MQTT_USERNAME='mqtt'
# MQTT username environment variable
ENV MQTT_USERNAME="$MQTT_USERNAME"

### Users

# Create user group and add user to the group
RUN getent group "$GROUP" || addgroup --gid "$GROUP_ID" "$GROUP" && adduser --uid "$USER_ID" --system --ingroup "$GROUP" "$USER"

### Packages

# Install GNU Gettext evironment substitution and Mosquitto MQTT broker
RUN apk update && apk add --no-cache gettext-envsubst mosquitto

### Directories
# Mounted volumes are not available at the build time

### Configuration

# Set container host name
RUN echo "$APP" > '/etc/hostname' && echo "127.0.1.1 $DOMAIN $APP" >> '/etc/hosts'

# Delete default configuration
RUN rm '/etc/mosquitto/mosquitto.conf'

# Copy configuration template to the temporary directory
COPY 'mosquitto-config-template.conf' '/tmp/mosquitto-config-template.conf'

# Create configuration file from the Mosquitto configuration template and delete the configuration template
RUN envsubst < '/tmp/mosquitto-config-template.conf' > "$CONFIG_FILE" && rm '/tmp/mosquitto-config-template.conf'

### Secrets
# Secrets are not available at the build time

## Password file

# Create password file and set the password file ownership and permissions
# RUN touch "$PASSWORD_FILE" && chown "$USER":"$GROUP" "$PASSWORD_FILE" && chmod 700 "$PASSWORD_FILE"

### Scripts

# Copy initialization script
COPY "$APP-init.sh" "/usr/local/bin/$APP-init"

# Make the initialization script executable
RUN chmod +x "/usr/local/bin/$APP-init"

### Ports

# EXPOSE "$MQTT_PORT"

### User

# Switch to container user
# USER "$USER"

ENTRYPOINT ["mosquitto-init"]