# marcobarrios.fi NGINX container image
# marcobarrios.fi-nginx

# Latest Alpine release
FROM alpine:latest

### Metadata

# Container image version
LABEL version='1.0.0'
# Application name
LABEL image.app-name='NGINX'
# Container image description
LABEL description='Web server and reverse proxy'
# Operating system version
LABEL image.os-version='3.21.3'
# Application version
LABEL image.app-version='1.26.1'
# Application website
LABEL image.app-url='https://nginx.org/'

### Variables

# App build-time variable
ARG APP='nginx'
# App environment variable
ENV APP="$APP"

# Domain build-time variable
ARG DOMAIN='localhost'
# Domain environment variable
ENV DOMAIN="$DOMAIN"

# Group identification build-time variable
ARG GROUP_ID='101'
# Group name build-time variable
ARG GROUP="$APP"

# User identification build-time variable
ARG USER_ID='101'
# User name build-time variable
ARG USER="$APP"

# Data directory build-time variable
ARG DATA_DIR="/var/lib/$APP"
# Data directory environment variable
ENV DATA_DIR="$DATA_DIR"

# Log file build-time variable
ARG LOG_FILE="/var/log/$APP.log"
# Log file environment variable
ENV LOG_FILE="$LOG_FILE"

## Sites Configuration

# Sites directory build-time variable
ARG SITES_DIR='/var/lib/nginx/html'
# Sites directory environment variable
ENV SITES_DIR="$SITES_DIR"

## Ports Configuration

# HTTP port build-time variable
ARG HTTP_PORT='80'
# HTTP port environment variable
ENV HTTP_PORT="$HTTP_PORT"

# HTTPS port build-time variable
ARG HTTPS_PORT='443'
# HTTPS port environment variable
ENV HTTPS_PORT="$HTTPS_PORT"

## GeoIP Configuration

# GeoIP country database file build-time variable
ARG GEOIP_COUNTRY_DB_FILE='/usr/share/GeoIP/GeoIP2-Country.mmdb'
# GeoIP country database file environment variable
ENV GEOIP_COUNTRY_DB_FILE="$GEOIP_COUNTRY_DB_FILE"

# GeoIP city database file build-time variable
ARG GEOIP_CITY_DB_FILE='/usr/share/GeoIP/GeoIP2-City.mmdb'
# GeoIP city database file environment variable
ENV GEOIP_CITY_DB_FILE="$GEOIP_CITY_DB_FILE"

# GeoIP ASN database file build-time variable
ARG GEOIP_ASN_DB_FILE='/usr/share/GeoIP/GeoIP2-ASN.mmdb'
# GeoIP ASN database file environment variable
ENV GEOIP_ASN_DB_FILE="$GEOIP_ASN_DB_FILE"

### Users

# Create user group and add user to the group
RUN getent group "$GROUP" || addgroup --gid "$GROUP_ID" "$GROUP" && adduser --uid "$USER_ID" --system --ingroup "$GROUP" "$USER"

### Packages

# Install GNU Gettext environment substitution, NGINX web server and reverse proxy, and NGINX HTTP GeoIP2 and JavaScript modules
RUN apk update && apk add --no-cache gettext-envsubst nginx nginx-mod-http-geoip2 nginx-mod-http-js

### Directories
# Mounted volumes are not available at the build time

# Create configuration directory
RUN mkdir -p '/etc/nginx/conf.d'

### Configuration

# Set container host name
RUN echo "$APP" > '/etc/hostname' && echo "127.0.1.1 $DOMAIN $APP" >> '/etc/hosts'

# Copy configuration template
COPY 'nginx-config-template.conf' '/tmp/nginx-config-template.conf'

# Delete default configuration file, create configuration file from the configuration template, and delete the configuration template
RUN rm '/etc/nginx/nginx.conf' && envsubst < '/tmp/nginx-config-template.conf' > '/etc/nginx/nginx.conf' && rm '/tmp/nginx-config-template.conf'

## PHP-FPM (PHP FastCGI Process Manager) Configuration

# Copy PHP-FPM configuration template to the temporary directory
COPY 'nginx-php-fpm-config-template.conf' '/tmp/php-fpm-config-template.conf'

# Create PHP-FPM configuration file from the configuration template and delete the configuration template
RUN envsubst < '/tmp/php-fpm-config-template.conf' > '/etc/nginx/php-fpm.conf' && rm '/tmp/php-fpm-config-template.conf'

# Copy FastCGI parameters configuration file to the temporary directory
COPY 'nginx-fastcgi-params.conf' '/tmp/fastcgi-params.conf'

# Append FastCGI parameters to the FastCGI configuration file and delete the configuration template
RUN envsubst < '/tmp/fastcgi-params.conf' >> '/etc/nginx/fastcgi.conf' && rm '/tmp/fastcgi-params.conf'

## GeoIP Configuration

# Copy GeoIP configuration template to the temporary directory
COPY 'nginx-geoip-config-template.conf' '/tmp/geoip-config-template.conf'

# Create GeoIP configuration file from the configuration template and delete the configuration template
RUN envsubst < '/tmp/geoip-config-template.conf' > '/etc/nginx/geoip.conf' && rm '/tmp/geoip-config-template.conf'

### Hosts Configuration

# Delete default host configuration
RUN rm '/etc/nginx/http.d/default.conf'

# Copy host configuration files to the temporary directory
COPY 'hosts/'*.conf '/tmp/hosts/'

# Copy sites directory to the temporary directory
COPY 'sites/' '/tmp/sites/'

# Copy initialization script
COPY "$APP-init.sh" "/usr/local/bin/$APP-init"

# Make the initialization script executable
RUN chmod +x "/usr/local/bin/$APP-init"

# Copy reload script
COPY "$APP-reload.sh" "/usr/local/bin/$APP-reload"

# Make the reload script executable and schedule the script to run weekly
# Todo: Verify that scheduling works
RUN chmod +x "/usr/local/bin/$APP-reload" && cp "/usr/local/bin/$APP-reload" '/etc/periodic/weekly/'

### Ports

EXPOSE "$HTTP_PORT" "$HTTPS_PORT"

# Switch to container user
# USER "$USER"

ENTRYPOINT ["nginx-init"]