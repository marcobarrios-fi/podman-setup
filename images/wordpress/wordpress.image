# marcobarrios.fi WordPress image
# marcobarrios.fi-wordpress

# Latest Alpine release
FROM alpine:latest

# Container image version
LABEL version='1.0.0'
# Application name
LABEL image.app-name='WordPress'
# Container image description
LABEL description='Open source publishing platform'
# Operating system version
LABEL image.os-version='3.21.3'
# Application version
LABEL image.app-version='7.1.3'
# Application website
LABEL image.app-url='https://wordpress.org/'
# Application documentation
LABEL image.app-docs='https://wordpress.org/documentation/'

### Variables

# App build-time variable
ARG APP='wordpress'
# App environment variable
ENV APP="$APP"

# Domain build-time variable
ARG DOMAIN='localhost'
# Domain environment variable
ENV DOMAIN="$DOMAIN"

## Group ID and group name

# Group identification build-time variable
ARG GROUP_ID='101'
# Group identification environment variable
ENV GROUP_ID="$GROUP_ID"
# Group name build-time variable
ARG GROUP="$APP"
# Group name environment variable
ENV GROUP="$GROUP"

## User ID and user name

# User identification build-time variable
ARG USER_ID='101'
# User identification environment variable
ENV USER_ID="$USER_ID"
# User name build-time variable
ARG USER="$APP"
# User name environment variable
ENV USER="$USER"

# Application directory build-time variable
ARG APP_DIR='/var/www/html/wordpress'
# Application directory environment variable
ENV APP_DIR="$APP_DIR"

# Data directory build-time variable
ARG DATA_DIR='/var/www/html/wordpress'
# Data directory environment variable
ENV DATA_DIR="$DATA_DIR"

# Configuration file build-time variable
ARG CONFIG_FILE="$APP_DIR/wp-config.php"
# Configuration file environment variable
ENV CONFIG_FILE="$CONFIG_FILE"

# Database directory build-time variable
ARG DB_DIR="$DATA_DIR"
# Database directory environment variable
ENV DB_DIR="$DB_DIR"

# Database file build-time variable
ARG DB_FILE='wordpress.sqlite.db'
# Database file environment variable
ENV DB_FILE="$DB_FILE"

# Log directory build-time variable
# (directory for access and error log)
ARG LOG_DIR="/var/log/$APP"
# Log directory environment variable
ENV LOG_DIR="$LOG_DIR"

# PHP version build-time variable
ARG PHP_VERSION='php84'
# PHP-FPM version build-time variable
ARG PHP_FPM_VERSION='php-fpm84'

# PHP-FPM socket build-time variable 
# (default value is /run/php/php8.4-fpm.sock)
ARG PHP_FPM_SOCKET='/run/php/php-fpm.sock'
# PHP-FPM socket environment variable
ENV PHP_FPM_SOCKET="$PHP_FPM_SOCKET"

# WordPress source URL
ARG SOURCE_URL='https://wordpress.org/latest.tar.gz'

# WordPress SQLite Database Integration Plugin 
# (https://wordpress.org/plugins/sqlite-database-integration/)

# WordPress SQLite Database Integration Plugin release information
ARG SQLITE_DB_RELEASE_INFO='https://api.github.com/repos/aaemnnosttv/wp-sqlite-db/releases/latest'
# WordPress SQLite Database Integration Plugin source URL
ARG SQLITE_DB_SOURCE_URL='https://raw.githubusercontent.com/aaemnnosttv/wp-sqlite-db'

# WordPress Command-Line Utility 
# (https://make.wordpress.org/cli/)

# WordPress Command-Line Utility source URL
ARG CLI_SOURCE_URL='https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar'

### Users

# Create user group and add user to the group
RUN getent group "$GROUP" || addgroup --gid "$GROUP_ID" "$GROUP" && adduser --uid "$USER_ID" --system --ingroup "$GROUP" "$USER"

### Packages

# Install GNU Gettext environment substitution, JSON command-line processor, PHP hypertext preprocessor, and PHP command-line interface (CLI), PHP FastCGI process manager (FPM), and PHP client URL extensions
# Install PHP SQLite 3, PHP data objects (PDO), and PHP data objects SQLite extensions required by the WordPress SQLite database integration plugin
# Install PHP archive (PHAR), PHP internationalization conversion, and PHP multi-byte extensions required by the WordPress command-line utility
# Install PHP document object model (DOM), PHP exchangeable image file format (EXIF), PHP file information, PHP graphics draw, PHP internationalization, PHP extensible markup language (XML), and PHP ZIP file format extensions used by WordPress

RUN apk update && apk add --no-cache gettext-envsubst jq "$PHP_VERSION" "$PHP_VERSION-cli" "$PHP_VERSION-fpm" "$PHP_VERSION-curl" "$PHP_VERSION-sqlite3" "$PHP_VERSION-pdo" "$PHP_VERSION-pdo_sqlite" "$PHP_VERSION-phar" "$PHP_VERSION-iconv" "$PHP_VERSION-mbstring" "$PHP_VERSION-dom" "$PHP_VERSION-exif" "$PHP_VERSION-fileinfo" "$PHP_VERSION-gd" "$PHP_VERSION-iconv" "$PHP_VERSION-intl" "$PHP_VERSION-xml" "$PHP_VERSION-zip"

### Symbolic Links

# Create symbolic link to PHP, PHP-FPM, PHP configuration directory, and PHP log directory
RUN ln -s "/usr/bin/$PHP_VERSION" '/usr/bin/php' && ln -s "/usr/sbin/$PHP_FPM_VERSION" '/usr/sbin/php-fpm' && ln -s "/etc/$PHP_VERSION" '/etc/php' && ln -s "/var/log/$PHP_VERSION" '/var/log/php'

### Directories 
# Mounted volumes are not available at the build time

### Configuration

# Set container host name
RUN echo "$APP" > '/etc/hostname' && echo "127.0.1.1 $DOMAIN $APP" >> '/etc/hosts'

## PHP FastCGI Process Manager (FPM)

# Copy PHP-FPM configuration template to the temporary directory
COPY 'wordpress-php-fpm-config-template.conf' '/tmp/php-fpm-config-template.conf'

# Delete the default PHP-FPM configuration file, create configuration file from the configuration template, and delete the template
RUN rm '/etc/php/php-fpm.d/www.conf' && envsubst < '/tmp/php-fpm-config-template.conf' > '/etc/php/php-fpm.d/php-fpm.conf' && rm '/tmp/php-fpm-config-template.conf'

## WordPress (WP)

# Download the latest version of WordPress, extract the archive, move the files to the temporary directory, and the delete the downloaded archive
RUN wget -O "$APP.tar.gz" "$SOURCE_URL" && tar -xzf "$APP.tar.gz" && mv "$APP" "/tmp/$APP" && rm "$APP.tar.gz"
  
# Copy WordPress configuration file to the temporary directory
COPY 'wordpress-config.php' "/tmp/$APP/wp-config.php"

## WordPress SQLite Database Integration Plugin (WP-SQLite-DB)

# Download release information for the latest version of WordPress SQLite database integration plugin, parse the version number and assign it to a variable, download the latest version of the plugin to the temporary WordPress content directory, and delete the release information
RUN wget -O 'wp-sqlite-db-latest.json' "$SQLITE_DB_RELEASE_INFO" && VERSION="$(jq -r '.tag_name' 'wp-sqlite-db-latest.json')" && wget -O "/tmp/$APP/wp-content/db.php" "$SQLITE_DB_SOURCE_URL/$VERSION/src/db.php" && rm 'wp-sqlite-db-latest.json'

## WordPress Command-Line Utility (WP-CLI)

# Download the WordPress command-line utility, move it to the binaries directory, and make it executable
RUN wget -O 'wp-cli.phar' "$CLI_SOURCE_URL" && mv 'wp-cli.phar' '/usr/local/bin/wp' && chmod +x '/usr/local/bin/wp'

### Secrets

### Scripts

# Copy initialization script
COPY "$APP-init.sh" "/usr/local/bin/$APP-init"

# Make the initialization script executable
RUN chmod +x "/usr/local/bin/$APP-init"

### Ports

# Expose port 9000 (not applicable when using sockets)
EXPOSE 9000

### User

# Switch to container user
# USER "$USER"

ENTRYPOINT ["wordpress-init"]